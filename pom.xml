<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.3</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.ledgerline</groupId>
	<artifactId>ledgerline</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>ledgerline</name>
	<description>LedgerLine</description>

	<properties>
		<java.version>21</java.version>
		<testcontainers.version>1.21.3</testcontainers.version>
	</properties>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Registers the /actuator/prometheus scrape endpoint. Without this,
		     actuator exposes metrics only through its own JSON shape, which
		     Prometheus cannot scrape directly. -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Kafka client. Unavoidable for today's goal: there is no way to reach
		     a broker without it. Version is managed by the Spring Boot parent. -->
		<dependency>
			<groupId>org.springframework.kafka</groupId>
			<artifactId>spring-kafka</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Real throwaway Postgres for tests. The invariant under test is that
		     Postgres plus our constraints produce a balanced ledger, which a
		     mocked datasource cannot verify. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- Real broker for the producer tests, for the same reason Postgres is
		     real: serialization and partitioning are properties of the broker
		     protocol, and a mock cannot demonstrate them. -->
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>kafka</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<!-- Coverage, so the state machine's branch number is measured rather
			     than estimated. Scoped to the domain package: it is pure logic
			     with no I/O, so 100% is both achievable and meaningful there,
			     which is not true of the layers that talk to Postgres or Kafka. -->
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<version>0.8.12</version>
				<configuration>
					<includes>
						<include>com/ledgerline/domain/**</include>
					</includes>
				</configuration>
				<executions>
					<execution>
						<id>prepare-agent</id>
						<goals>
							<goal>prepare-agent</goal>
						</goals>
					</execution>
					<execution>
						<id>report</id>
						<phase>test</phase>
						<goals>
							<goal>report</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<!-- docker-java negotiates Docker API v1.32 by default, which is
					     below the v1.40 floor enforced by Docker Engine 29. The
					     daemon answers the /info probe with HTTP 400, and
					     Testcontainers reads that as "no Docker available". Asking
					     for a version above the floor lets it connect; the client
					     then negotiates the daemon's actual version. -->
					<!-- @{argLine} carries whatever JaCoCo's prepare-agent set.
					     Without it, this property would replace the agent flag
					     instead of adding to it, and coverage would silently
					     report zero. -->
					<argLine>@{argLine} -Dapi.version=1.43</argLine>

					<!-- Stated explicitly rather than left to surefire's defaults.
					     Two classes in this repo have already been written, compiled,
					     and committed without ever executing, because their names
					     matched none of the default patterns (*Test, Test*, *Tests,
					     *TestCase): a pair of Day 3 sabotage classes named *Probe.
					     They passed review, passed compilation, and reported nothing,
					     which is the worst possible failure mode for a test.

					     The list below is deliberately broader than the default so
					     that the plausible names someone reaches for (Probe, Spec,
					     IT) are collected rather than silently dropped. Anything
					     outside it is still invisible, which is why
					     SurefireInclusionTest exists: it asserts that every
					     @Test-bearing class under src/test/java matches one of these
					     patterns, so a class named outside the list fails the build
					     instead of disappearing from it. -->
					<includes>
						<include>**/*Test.java</include>
						<include>**/Test*.java</include>
						<include>**/*Tests.java</include>
						<include>**/*TestCase.java</include>
						<include>**/*Probe.java</include>
						<include>**/*Spec.java</include>
						<include>**/*IT.java</include>
					</includes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
